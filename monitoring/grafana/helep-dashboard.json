{
  "title": "HELEP Services Dashboard",
  "uid": "helep-services",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "User Signups (total)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(helep_user_signups_total)",
          "legendFormat": "Signups"
        }
      ]
    },
    {
      "id": 2,
      "title": "SOS Incidents Triggered (total)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [
        {
          "expr": "sum(helep_sos_triggers_total)",
          "legendFormat": "SOS Events"
        }
      ]
    },
    {
      "id": 3,
      "title": "Responders Assigned (total)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "sum(helep_dispatch_assigned_total)",
          "legendFormat": "Assignments"
        }
      ]
    },
    {
      "id": 4,
      "title": "Notifications Sent (total)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(helep_notifications_sent_total)",
          "legendFormat": "Notifications"
        }
      ]
    },
    {
      "id": 5,
      "title": "Danger Zone Hits (total)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "sum(helep_dispatch_zone_hits_total)",
          "legendFormat": "Zone Hits"
        }
      ]
    },
    {
      "id": 6,
      "title": "HTTP Request Rate by Service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "rate(http_requests_total{namespace=\"helep\"}[1m])",
          "legendFormat": "{{ service }}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Pod CPU Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{namespace=\"helep\", container!=\"\"}[1m])",
          "legendFormat": "{{ pod }}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Pod Memory Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{namespace=\"helep\", container!=\"\"}",
          "legendFormat": "{{ pod }}"
        }
      ]
    },
    {
      "id": 9,
      "title": "HPA Replica Count",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"helep\"}",
          "legendFormat": "{{ horizontalpodautoscaler }}"
        }
      ]
    }
  ]
}
